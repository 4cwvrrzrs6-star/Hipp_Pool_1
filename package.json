function musicPlay(i){musicStop();save.mus=i;store();if(i<0||!AC)return;if(!mG){mG=AC.createGain();mG.connect(AC.destination);}setVol();const T=TR[i],d=30/T.bpm;let n=AC.currentTime+.1,s=0;
 const tone=(m,t,du,ty,g,a)=>{const o=AC.createOscillator(),e=AC.createGain();o.type=ty;o.frequency.value=440*2**((m-69)/12);e.gain.setValueAtTime(.0001,t);e.gain.linearRampToValueAtTime(g,t+a);e.gain.exponentialRampToValueAtTime(.0001,t+du);o.connect(e);e.connect(mG);o.start(t);o.stop(t+du+.05);};
 mt=setInterval(()=>{while(n<AC.currentTime+.4){const c=T.ch[(s>>3)%T.ch.length];if(s%8==0)c.forEach(m=>tone(m,n,d*8,T.w,.05,.6));if(s%4==0)tone(c[0]-24,n,d*3,'sine',.14,.02);if(T.arp==1||(T.arp==2&&s%2==0)||(T.arp==0&&s%3==0))tone(c[(s*3)%c.length]+12,n,d*1.5,'triangle',.05,.01);n+=d;s++;}},100);}
$('mf').onchange=e=>{const f=e.target.files[0];if(!f)return;AC=AC||new(window.AudioContext||window.webkitAudioContext)();musicPlay(-1);aud.src=URL.createObjectURL(f);aud.loop=true;setVol();aud.play();save.mus=-2;};
// bot / coach
function segd(px,pz,ax,az,bx,bz){const dx=bx-ax,dz=bz-az,q=Math.max(0,Math.min(1,((px-ax)*dx+(pz-az)*dz)/(dx*dx+dz*dz||1)));return Math.hypot(px-ax-dx*q,pz-az-dz*q);}
function plan(g){const c=balls[0],al=balls.filter(b=>!b.in&&b!==c),own=n=>g?(g=='s'?n>=1&&n<=7:n>=9):n!=8;let T=al.filter(b=>own(b.n));if(g&&!T.length)T=al.filter(b=>b.n==8);
 const free=(ax,az,bx,bz,t)=>al.every(o=>o===t||segd(o.x,o.z,ax,az,bx,bz)>2*R+.3);let best=null;
 for(const t of T)for(const p of PK){const dx=p[0]-t.x,dz=p[1]-t.z,dd=Math.hypot(dx,dz),gx=t.x-dx/dd*2*R,gz=t.z-dz/dd*2*R,cx=gx-c.x,cz=gz-c.z,cd=Math.hypot(cx,cz);if(cd<1)continue;const cs=(cx*dx+cz*dz)/(cd*dd);if(cs<.35||!free(c.x,c.z,gx,gz,t)||!free(t.x,t.z,p[0],p[1],t))continue;const sc2=cs*2-cd/300-dd/400;if(!best||sc2>best.sc)best={sc:sc2,t,ax:cx/cd,az:cz/cd,p:Math.min(.9,Math.max(.3,.25+cd/260+dd/320))};}
 if(!best){const t=[...T].sort((a,b)=>Math.hypot(a.x-c.x,a.z-c.z)-Math.hypot(b.x-c.x,b.z-c.z))[0]||al[0],dx=t.x-c.x,dz=t.z-c.z,d=Math.hypot(dx,dz);best={t,ax:dx/d,az:dz/d,p:.5};}return best;}
function doShoot(){const c=balls[0],s=power*480*SM();c.vx=aim.x*s;c.vz=aim.z*s;c.rx=aim.x*s*spin.y*1.3;c.rz=aim.z*s*spin.y*1.3;c.sp=spin.x*s*.5;snd(300,power,.1);shot={first:null,pot:[]};st='moving';power=0;}
function botMove(){const c=balls[0];if(lob||!botMode||cur!=1){botBusy=false;return;}
 if(st=='place'){let x=-L/2,z=0;for(let k=0;k<40&&balls.some(b=>b!==c&&!b.in&&Math.hypot(b.x-x,b.z-z)<2*R+1);k++)z=(Math.random()-.5)*60;c.x=c.px=x;c.z=c.pz=z;c.in=false;c.vx=c.vz=c.rx=c.rz=0;c.mesh.position.set(x,R,z);st='aim';botBusy=false;return;}
 if(st!='aim'){botBusy=false;return;}
 const b=plan(grp[1]),a=Math.atan2(b.az,b.ax)+(Math.random()-.5)*.03;aim.x=Math.cos(a);aim.z=Math.sin(a);msg('Никита Калогривый целится...');let p=0;
 const iv=setInterval(()=>{p+=.05;power=Math.min(p,b.p);if(p>=b.p||st!='aim'){clearInterval(iv);if(st=='aim'){const u={x:spin.x,y:spin.y};spin.x=0;spin.y=0;doShoot();spin.x=u.x;spin.y=u.y;}botBusy=false;}},30);}
$('hint').onclick=()=>{if(st!='aim'||lk())return;const b=plan(grp[cur]),c=balls[0],d=Math.hypot(b.t.x-c.x,b.t.z-c.z),a=hl.geometry.attributes.position;a.setXYZ(0,c.x,R,c.z);a.setXYZ(1,c.x+b.ax*d,R,c.z+b.az*d);a.needsUpdate=true;hintUntil=performance.now()+4000;msg('Тренер Никита: бейте по шару '+b.t.n+', сила около '+Math.round(b.p*100)+'%');};
const COACH='data:image/jpeg;base64,';
let BS={r:.18,m:0,e:0},net=null,NR=null,hostWait=false,roomCode='',lastAimT=0,lastSnapT=0,lastNet=0,netLost=false;
const lk=()=>(botMode&&cur==1)||(net&&cur!=net.me);
function hudNames(a,b){$('p0').querySelector('b').textContent=a;$('p1').querySelector('b').textContent=b;let i=$('cph');if(!i){i=document.createElement('img');i.id='cph';i.className='coach';$('p1').prepend(i);}i.style.display=botMode?'':'none';i.src=save.photo||COACH;}
$('pf').onchange=e=>{const f=e.target.files[0];if(!f)return;const im=new Image();im.onload=()=>{const c=document.createElement('canvas');c.width=c.height=128;const g=c.getContext('2d'),s=Math.min(im.width,im.height);g.drawImage(im,(im.width-s)/2,(im.height-s)/2,s,s,0,0,128,128);save.photo=c.toDataURL('image/jpeg',.8);store();tabv('set');};im.src=URL.createObjectURL(f);};
// online (room capability): the shooter simulates and streams ball positions
const nemit=d=>{if(NR)NR.emit('hp',d).catch(()=>{});};
const snap=()=>balls.map(b=>b.in?0:[+b.x.toFixed(1),+b.z.toFixed(1)]);
function applySnap(a){a.forEach((v,i)=>{const b=balls[i];if(!b)return;if(!v){b.in=true;b.mesh.visible=false;return;}b.in=false;b.mesh.visible=true;b.rx=(v[0]-b.x)*15;b.rz=(v[1]-b.z)*15;b.x=v[0];b.z=v[1];});}
function netEnd(){if(net)nemit({t:'end',c:cur,st,g:grp,m:$('msg').textContent,b:snap()});}
function startNet(o){botMode=false;lob=false;document.body.classList.remove('lob');fit();reset(o);hudNames(net.me==0?'Вы':'Соперник',net.me==1?'Вы':'Соперник');}
function onNet(m){if(m.isMe)return;const d=m.data||{};lastNet=performance.now();netLost=false;
 if(d.t=='hello'&&hostWait&&!net){hostWait=false;net={me:0};startNet(null);nemit({t:'rack',o:balls.map(b=>b.n)});}
 else if(d.t=='rack'&&(!net||net.me==1)&&!hostWait){net={me:1};startNet(d.o);}
 else if(!net)return;
 else if(d.t=='bye'){msg('Соперник вышел из комнаты');netLost=true;}
 else if(d.t=='chat'){toast(String(d.m||'').slice(0,60));}
 else if(d.t=='aim'&&cur!=net.me&&st=='aim'){aim.x=d.x;aim.z=d.z;power=d.p;}
 else if(d.t=='pl'&&cur!=net.me&&st=='place'){const c=balls[0];c.x=c.px=d.x;c.z=c.pz=d.z;c.in=false;c.vx=c.vz=0;c.mesh.visible=true;c.mesh.position.set(d.x,R,d.z);st='aim';}
 else if(d.t=='s'&&cur!=net.me){st='moving';power=0;applySnap(d.b);}
 else if(d.t=='end'&&cur!=net.me){applySnap(d.b);cur=d.c;st=d.st;grp=d.g;if(st=='place')balls[0].mesh.visible=true;msg(d.m);if(st=='over'){save.coins+=100;save.xp+=60;store();}upd();}}
async function sockRoom(){if(!window.io){await new Promise((ok,no)=>{const s=document.createElement('script');s.src='/socket.io/socket.io.js';s.onload=ok;s.onerror=()=>no(new Error('сервер недоступен'));document.head.append(s);});}
 return {join:name=>new Promise((ok,no)=>{const so=io();so.on('connect_error',()=>no(new Error('нет связи с сервером')));so.on('full',()=>no(new Error('комната занята')));so.on('joined',()=>ok({emit:(t,d)=>{so.emit('hp',d);return Promise.resolve();},on:(t,f)=>so.on('hp',d=>f({data:d,isMe:false})),leave:()=>so.disconnect()}));so.emit('join',name);})};}
async function joinNet(code,host,out){code=(code||'').toLowerCase().replace(/[^a-z0-9]/g,'');if(!code){out.textContent='Введите код комнаты';return;}
 try{let r=null;try{r=window.claude?await claude.use('room'):null;}catch(e){}if(!r)r=await sockRoom();
  if(NR){try{NR.leave();}catch(e){}}NR=await r.join('hp-'+code);NR.on('hp',onNet);hostWait=host;net=null;
  out.textContent=host?'Комната '+code+' создана. Ждём соперника...':'Подключаюсь...';
  if(!host){let n=0;nemit({t:'hello'});const iv=setInterval(()=>{if(net||++n>15){clearInterval(iv);if(!net)out.textContent='Хозяин комнаты не отвечает';return;}nemit({t:'hello'});},2000);}}
 catch(e){out.textContent='Не удалось подключиться: '+(e.code||e.message);}}
function onlineCard(p){const c=el('div','card',0,p);el('b',0,'8 Ball: онлайн',c);const i=el('input',0,null,c);i.placeholder='Код комнаты';i.maxLength=12;i.value=roomCode;const o=el('span',0,'Играют те, у кого открыта эта страница и есть доступ',c);
 el('button','btn go','Создать',c).onclick=()=>{roomCode=i.value||Math.random().toString(36).slice(2,6);i.value=roomCode;joinNet(roomCode,true,o);};el('button','btn','Войти',c).onclick=()=>joinNet(i.value,false,o);}
const ch=$('chat');['Хороший удар!','Не повезло','GG'].forEach(t=>el('button','btn',t,ch).onclick=()=>{nemit({t:'chat',m:t});toast('Вы: '+t);});
function toast(t){const e=$('toast');e.textContent=t;e.style.display='block';clearTimeout(toast.k);toast.k=setTimeout(()=>e.style.display='none',3000);}
let pgc=0;setInterval(()=>{if(net&&++pgc%3==0)nemit({t:'ping'});ch.style.display=net&&!lob?'flex':'none';},1000);
const AB=[['giant','Огромный шар',4],['pow','Мощный удар',3],['slow','Замедление',3],['prec','Точность',2],['sh','Щит',5]];
const cd=[{},{}],ab={giant:0,pow:0,slow:0,prec:0},shield=[0,0];let slowUntil=0;
function SM(){const m=ab.pow?1.55:1;if(ab.slow)slowUntil=performance.now()+4500;ab.pow=ab.slow=ab.prec=0;return m;}
const mkL=c=>{const l=new THREE.Line(new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(),new THREE.Vector3()]),new THREE.LineBasicMaterial({color:c,transparent:true,opacity:.85}));l.frustumCulled=false;l.visible=false;sc.add(l);return l;};
const l2=mkL(0xff3d9a),l3=mkL(0xffffff),l4=mkL(0x3df2e0);
function aimExtra(c,X,Z,t,hb){const gx=c.x+X*t,gz=c.z+Z*t,k=ab.prec?2.3:1,S=(l,x1,z1,x2,z2)=>{const p=l.geometry.attributes.position;p.setXYZ(0,x1,R,z1);p.setXYZ(1,x2,R,z2);p.needsUpdate=true;l.visible=true;};
 l2.visible=l3.visible=l4.visible=false;
 if(hb){const nx=(hb.x-gx)/(c.r+hb.r),nz=(hb.z-gz)/(c.r+hb.r),dn=Math.max(0,X*nx+Z*nz),tx=X-dn*nx,tz=Z-dn*nz,tl=Math.hypot(tx,tz),a=(14+24*dn)*k;S(l2,hb.x,hb.z,hb.x+nx*a,hb.z+nz*a);if(tl>.05){const b2=(6+24*tl)*k;S(l3,gx,gz,gx+tx/tl*b2,gz+tz/tl*b2);}}
 else{const rx=Math.abs(gx)>=L-c.r-.05?-X:X,rz=Math.abs(gz)>=W-c.r-.05?-Z:Z;S(l4,gx,gz,gx+rx*45*k,gz+rz*45*k);}}
function abUI(){const a=$('abil');if(!a)return;a.innerHTML='';a.style.display=net?'none':'';AB.forEach(([id,n,cc])=>{const w=cd[cur][id]||0,on=id=='sh'?shield[cur]:ab[id],b=el('button','btn'+(on?' on':''),on?n+' (активно)':w?n+' ('+w+')':n,a);b.disabled=!!w||!!on;b.onclick=()=>useAb(id,cc);});}
function useAb(id,cc){if(st!='aim'||lk()||net)return;const c=balls[0];
 if(id=='giant'){if(balls.some(b=>b!==c&&!b.in&&Math.hypot(b.x-c.x,b.z-c.z)<R*1.8+b.r+.3)){msg('Рядом шар: нет места для огромного шара');return;}c.r=R*1.8;c.mesh.scale.setScalar(1.8);c.mesh.position.y=c.r;ab.giant=1;}
 else if(id=='sh')shield[cur]=1;else ab[id]=1;
 cd[cur][id]=cc+1;snd(520,.2,.2);abUI();}
apply();tabv('play');fit();reset();requestAnimationFrame(frame);
</script></body></html>
