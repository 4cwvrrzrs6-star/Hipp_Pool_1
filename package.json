{
  "name": "hipp-pool",
  "version": "0.1.0",
  "description": "Hipp Pool: 3D billiards in the browser with a Socket.IO room server",
  "main": "server.js",
  "scripts": { "start": "node server.js" },
  "engines": { "node": ">=18" },
  "dependencies": { "express": "^4.19.2", "socket.io": "^4.7.5" }
}

// Hipp Pool: сервер комнат. Раздаёт игру и пересылает сообщения между двумя игроками комнаты.
const express = require('express');
const http = require('http');
const path = require('path');
const { Server } = require('socket.io');

const app = express();
const srv = http.createServer(app);
const io = new Server(srv, { maxHttpBufferSize: 8192 });

app.use(express.static(path.join(__dirname, 'public')));
app.get('/health', (_req, res) => res.json({ ok: true, rooms: rooms.size }));

const rooms = new Map(); // код комнаты -> Set из id сокетов (не более 2)

io.on('connection', (s) => {
  let room = null;
  let tokens = 60, last = Date.now();

  s.on('join', (name) => {
    const code = String(name || '').toLowerCase().replace(/[^a-z0-9-]/g, '').slice(0, 24);
    if (!code || room) return;
    const set = rooms.get(code) || new Set();
    if (set.size >= 2) { s.emit('full'); return; }
    set.add(s.id);
    rooms.set(code, set);
    room = code;
    s.join(code);
    s.emit('joined', set.size);
  });

  s.on('hp', (d) => {
    if (!room) return;
    const now = Date.now();
    tokens = Math.min(60, tokens + ((now - last) / 1000) * 40);
    last = now;
    if (tokens < 1) return;            // защита от флуда
    tokens -= 1;
    let size = 0;
    try { size = JSON.stringify(d).length; } catch { return; }
    if (size > 4096) return;
    s.to(room).emit('hp', d);
  });

  s.on('disconnect', () => {
    if (!room) return;
    const set = rooms.get(room);
    if (set) { set.delete(s.id); if (!set.size) rooms.delete(room); }
    s.to(room).emit('hp', { t: 'bye' });
  });
});

const PORT = process.env.PORT || 3000;
srv.listen(PORT, () => console.log('Hipp Pool: http://localhost:' + PORT));

# Hipp Pool

3D-бильярд (8 Ball) в браузере: лобби, магазин, инвентарь, бот-тренер, способности и онлайн для двоих.

## Запуск
1. Установите Node.js 18 или новее.
2. В папке проекта выполните:
   ```
   npm install
   npm start
   ```
3. Откройте http://localhost:3000

## Игра с другом
- **В одной сети Wi-Fi:** узнайте IP компьютера (например 192.168.1.20), друг открывает `http://192.168.1.20:3000`.
- **Через интернет:** выложите папку на хостинг с Node.js (Render, Railway, Fly.io). Команда запуска `npm start`, порт берётся из переменной `PORT`. Друзья открывают выданный адрес.
- Один игрок жмёт «Играть → 8 Ball: онлайн → Создать» и вводит код комнаты, второй вводит тот же код и жмёт «Войти».

## Что внутри
- `server.js` — сервер комнат: до 2 игроков в комнате, пересылка сообщений, лимит частоты и размера.
- `public/index.html` — вся игра (Three.js подключается с cdnjs, нужен интернет).

## Честно о возможностях
- Сервер только пересылает сообщения. Физику считает клиент того, кто бьёт, поэтому честной защиты от читов нет.
- Аккаунтов, друзей, рейтинга и серверных покупок нет. Монеты, опыт и инвентарь хранятся в localStorage браузера.
- Способности в онлайне отключены. Остальные режимы (9 Ball, русская пирамида, 2 на 2) не сделаны.

